# CircuitFabric never stores secret values in project configuration or plugin manifests.
# Provider keys live in the desktop app's encrypted secrets vault (unlocked with a
# user-chosen vault password on startup); setting the same variables in the launch
# environment below remains supported as a fallback and for headless bridge use.
CIRCUITFABRIC_DATA_DIR=.circuitfabric-data
CIRCUITFABRIC_LOG=info

# Provider keys are referenced by name only. Values come from the unlocked secrets
# vault, or from the local environment when the vault does not define the name.
# They are never stored in RuntimeSettings or committed to the repository.
# JLCIRCUIT_LLM_API_KEY=<set locally or in the secrets vault>
# JLCIRCUIT_VISION_LLM_API_KEY=<set locally or in the secrets vault>
