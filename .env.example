# CircuitFabric never stores secret values in project configuration or plugin manifests.
# Configure local secret-provider integration outside version control.
CIRCUITFABRIC_DATA_DIR=.circuitfabric-data
CIRCUITFABRIC_LOG=info

# Provider keys are read by name from the local environment and are never
# stored in RuntimeSettings or committed to the repository.
# JLCIRCUIT_LLM_API_KEY=<set locally>
# JLCIRCUIT_VISION_LLM_API_KEY=<set locally>
