{
  "id": "jlcircuit-eda",
  "version": "0.1.0",
  "kind": "eda-backend",
  "apiVersion": "circuitfabric-plugin/v1",
  "capabilities": [
    "inspect",
    "preview",
    "apply",
    "readback",
    "rollback",
    "drc",
    "visual-capture",
    "bridge-chat",
    "bridge-context"
  ],
